# Copier ce fichier en .env (jamais commité) pour personnaliser docker compose.

# Compte Docker Hub qui publie les images (utilisé par « docker compose pull »).
DOCKERHUB_USERNAME=votre-compte-dockerhub

# Version des images : latest, ou l'identifiant d'un commit publié par la CI.
PMT_TAG=latest

# Mot de passe root de la base MySQL du conteneur.
MYSQL_ROOT_PASSWORD=pmt_root
